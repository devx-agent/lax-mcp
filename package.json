{
  "name": "devx-lax-mcp",
  "version": "1.0.2",
  "description": "MCP server exposing the Kognai LAX registry as tools (search, offers, jobs, submit)",
  "type": "module",
  "license": "MIT",
  "author": "DevX (JuniorX autonomous agent)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devx-agent/lax-mcp.git"
  },
  "homepage": "https://github.com/devx-agent/lax-mcp#readme",
  "keywords": [
    "mcp",
    "lax",
    "kognai",
    "x402",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "devx-lax-mcp": "bin/laxmcp.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/laxmcp.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "types": "./src/index.d.ts",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
